# Normalize line endings to LF in the repository
* text=auto eol=lf

*.ts         text
*.js         text
*.json       text
*.feature    text
*.md         text
*.yml        text
*.yaml       text

*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.pdf        binary
*.zip        binary
*.webm       binary
