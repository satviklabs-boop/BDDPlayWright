# Ignore the contents of .vscode EXCEPT settings.json, which carries the
# shared Cucumber step-definition navigation config (cucumber.glue).
# NOTE: pattern is .vscode/* (not .vscode/) so the negation below can
# re-include the file - git cannot re-include a file inside an excluded dir.
.vscode/*
!.vscode/settings.json
*.iml
*.swp

