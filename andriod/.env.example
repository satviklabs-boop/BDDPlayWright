# ============================================================================
# Android / Appium configuration.
# Copy this file to `andriod/.env` and edit what you need.
# Every value is optional - the default shown here is used when it is absent.
# ============================================================================

# ----- Device (USB debugging) -----
# Leave DEVICE_NAME empty to let Appium use the first attached device,
# or set it to the `udid` shown by `adb devices`.
DEVICE_NAME=
PLATFORM_VERSION=13
# Set ONLY when more than one device is attached, to target a specific one.
UDID=
# The emulator/device name shown in `adb devices` (used when starting an AVD).
AVD=

# ----- Application under test -----
# Path to the .apk on this machine. Required for app re-install (app:install).
APP_PATH=./andriod/apps/app-debug.apk
# Package + launcher activity of an app already installed on the device.
# These default to the natively pre-installed Android "Settings" app, so the
# smoke run works before you point this at your own app.
APP_PACKAGE=com.android.settings
APP_ACTIVITY=.Settings

# ----- Appium server -----
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
# Start a local Appium server automatically (true = recommended).
APPIUM_AUTOSTART=true

# ----- Behaviour -----
# Reset the app state (clear data) between scenarios. true feels closest to a
# fresh user install; false is faster when you do not need a clean slate.
NO_RESET=false

# ----- Reporting -----
ALLURE_RESULTS=andriod/allure-results
