{
  "name": "bdd-playwright-framework",
  "version": "1.0.0",
  "description": "Modern BDD test automation framework using Playwright - covers UI login and API testing",
  "keywords": [
    "playwright",
    "bdd",
    "cucumber",
    "gherkin",
    "typescript",
    "test-automation",
    "api-testing",
    "e2e"
  ],
  "license": "MIT",
  "author": "Satvik Labs",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bddgen": "bddgen",
    "test": "npm run bddgen && playwright test",
    "test:ui": "npm run bddgen && playwright test --project=ui-chromium",
    "test:api": "npm run bddgen && playwright test --project=api",
    "test:smoke": "npm run bddgen && playwright test --grep @smoke",
    "test:regression": "npm run bddgen && playwright test --grep @regression",
    "test:headed": "npm run bddgen && playwright test --project=ui-chromium --headed",
    "test:debug": "npm run bddgen && playwright test --project=ui-chromium --debug",
    "test:ui-mode": "npm run bddgen && playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,json,md,feature}\"",
    "clean": "rimraf playwright-report test-results allure-results allure-report .features-gen",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "allure-playwright": "^3.0.7",
    "dotenv": "^16.4.7",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.0"
  }
}
