# ============================================================================
# Copy to .env and change what you need. Read by tests/Routine/config.ts.
# Every value is optional - leave it out to use the default shown here.
# ============================================================================

# ----- URLs -----
BASE_URL=https://the-internet.herokuapp.com
API_BASE_URL=https://reqres.in

# ----- How tests run -----
HEADLESS=true
WORKERS=2
# Retries per failed test. 0 disables retries.
RETRIES=1
# Slow every browser action down by this many ms (useful for watching a run).
SLOW_MO=0

# ----- Retry analyser -----
# Report pass / flaky / failed after the run (test-results/retry/retry-report.txt).
ANALYSE_RETRIES=true
# Fail the build if any scenario passed only after a retry.
FAIL_ON_FLAKY=false
