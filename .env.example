# ============================================================================
# Environment configuration - copy to .env and adjust as needed
# ============================================================================
ENV=dev

# ----- UI (web) -----
BASE_URL=https://the-internet.herokuapp.com
UI_USERNAME=tomsmith
UI_PASSWORD=SuperSecretPassword!

# ----- API -----
API_BASE_URL=https://reqres.in
API_KEY=reqres-free-v1
API_USERNAME=eve.holt@reqres.in
API_PASSWORD=cityslicka

# ----- Execution -----
HEADLESS=true
WORKERS=2
# Playwright re-runs a failed test this many times. 0 disables retries.
RETRIES=1
DEFAULT_TIMEOUT=30000
SLOW_MO=0

# ----- Retry analyser -----
# Playwright reports a test that passed on a retry as a plain PASS, which hides
# an unstable test. The analyser reads the JSON report afterwards and separates
# pass / flaky / failed, then writes test-results/retry/retry-report.txt.
ANALYSE_RETRIES=true
RETRY_REPORT_DIR=test-results
RETRY_REPORT_FILE=results.json
RETRY_OUTPUT_DIR=test-results/retry
# Mark the build failed if any scenario passed only after a retry.
FAIL_ON_FLAKY=false
